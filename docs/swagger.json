{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Web-Based Software Development Platform Backend",
        "title": "SWDP Backend API",
        "termsOfService": "https://example.com/terms/",
        "contact": {
            "name": "Noble Eselase Vulley",
