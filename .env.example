ENV=development
DATABASE_URL=postgres://user:password@localhost:5432/app?sslmode=disable
JWT_SECRET=change-me

# ─── Runtime selection ────────────────────────────────────────────────────────
# "docker"      → Docker containers (default)
# "firecracker" → Firecracker MicroVMs (requires KVM on the host)
RUNTIME_TYPE=docker

# ─── Docker runtime ───────────────────────────────────────────────────────────
DOCKER_HOST=unix:///var/run/docker.sock

# ─── Firecracker runtime (only needed when RUNTIME_TYPE=firecracker) ──────────
# Download kernel:  see internal/runtime/firecracker.go for setup instructions
FIRECRACKER_KERNEL_PATH=/opt/firecracker/vmlinux
FIRECRACKER_ROOTFS_BASE=/opt/firecracker/ubuntu-22.04.ext4
FIRECRACKER_WORKSPACE_DIR=/var/swdp/workspaces
